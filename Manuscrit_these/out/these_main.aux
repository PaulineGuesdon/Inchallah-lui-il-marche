\@writefile{lof}{\contentsline {figure}{\numberline {1.28}{\ignorespaces Principle of spin-selective detection via coherent momentum transfer. (a) Counter-propagating beam geometry of the lasers used for the TLS and two-photon Raman scheme. (b) Energy levels scheme of the Raman process, with recoil energy shifting the $m_F+2$ level. (c) Avoided crossing due to the coupling of the states, necessiting adiabatic transfer. (d) Resulting TOF absorption image showing spatially separated spin components and the corresponding lilentul distribution.}}{36}{figure.caption.90}\protected@file@percent }
\newlabel{fig:intro-spin-kick-scheme}{{1.28}{36}{Principle of spin-selective detection via coherent momentum transfer. (a) Counter-propagating beam geometry of the lasers used for the TLS and two-photon Raman scheme. (b) Energy levels scheme of the Raman process, with recoil energy shifting the $m_F+2$ level. (c) Avoided crossing due to the coupling of the states, necessiting adiabatic transfer. (d) Resulting TOF absorption image showing spatially separated spin components and the corresponding lilentul distribution}{figure.caption.90}{}}
